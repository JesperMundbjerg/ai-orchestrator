{
  "name": "review-inbox",
  "version": "0.2.0",
  "description": "A local review inbox for long-running agent projects: decisions, previews and milestones in one queue, replies routed to the owning conversation",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JesperMundbjerg/review-inbox"
  },
  "homepage": "https://github.com/JesperMundbjerg/review-inbox",
  "bugs": {
    "url": "https://github.com/JesperMundbjerg/review-inbox/issues"
  },
  "private": true,
  "bin": {
    "inbox": "./bin/inbox"
  },
  "scripts": {
    "start": "node src/server/main.ts",
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "restart-office": "node scripts/restart-office.ts",
    "demo": "node scripts/demo.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=24.2.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@react-three/fiber": "^9.8.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "12.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "typebox": "^1.3.34"
  }
}
