{
  "name": "review-inbox",
  "version": "0.2.0",
  "description": "A local review inbox for long-running agent projects: decisions, previews and milestones in one queue, replies routed to the owning conversation",
  "type": "module",
  "private": true,
  "bin": {
    "inbox": "./bin/inbox"
  },
  "scripts": {
    "start": "node src/server/main.ts",
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "demo": "node scripts/demo.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "typebox": "^1.3.34"
  }
}
